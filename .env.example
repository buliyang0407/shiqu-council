# Fill these when you want real model calls. Without API keys the app runs in mock mode.
PORT=5173

MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# Token Plan currently rejects web_search tools in direct app calls.
# Enable only after the Xiaomi gateway accepts tools for your key, or when using a compatible sk key.
MIMO_ENABLE_WEB_SEARCH=false
MIMO_FORCE_SEARCH=false

AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1

RUNNINGHUB_API_KEY=
